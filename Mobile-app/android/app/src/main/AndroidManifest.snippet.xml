<!--
  This is not a full manifest — merge these pieces into your project's
  android/app/src/main/AndroidManifest.xml (generated by `npx react-native
  init`). The two things that matter for Chotubot:

  1. INTERNET permission (RN apps usually already have this)
  2. The ChotuNotificationListenerService declaration with
     BIND_NOTIFICATION_LISTENER_SERVICE — this is what lets Android offer
     "Chotubot" in Settings > Notification access.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/AppTheme">

        <!-- ... your existing <activity> entries stay as-is ... -->

        <service
            android:name="com.chotubot.notiflistener.ChotuNotificationListenerService"
            android:label="Chotubot"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
